

{% liquid
  assign icons_style = section.settings.icons_style
  assign columns = section.settings.columns | default: 4
  assign mobile_columns = section.settings.mobile_columns | default: 1

  assign color_scheme_class = ''
  if block.settings.inherit_color_scheme == false
    assign color_scheme_class = 'color-' | append: block.settings.color_scheme
  endif

  if section.settings.section_width == 'page-width'
    assign gutter = 'var(--util-page-margin-offset)'
    assign arrows_class = 'px-[var(--util-page-margin-offset)]'
  else
    assign gutter = '0px'
    assign arrows_class = ''
  endif

  assign show_arrows = false
  if icons_style != 'none'
    assign show_arrows = true
  endif

  # Card height "fill" stretches every card to the tallest one; otherwise cards align to the chosen position.
  assign list_class = 'items-start'
  if block.settings.height == 'fill'
    assign list_class = 'items-stretch'
  else
    case block.settings.position
      when 'center'
        assign list_class = 'items-center'
      when 'bottom'
        assign list_class = 'items-end'
    endcase
  endif

  # Desktop: `columns` cards per page with the next card peeking. Mobile: `mobile_columns` cards per page.
  capture config
    echo '{"perPage":' | append: columns
    echo ',"gap":"var(--carousel-gap, 8px)"'
    echo ',"padding":{"left":"' | append: gutter | append: '","right":"calc(' | append: gutter | append: ' + var(--peek-next-slide-size, 0px))"}'
    echo ',"arrows":' | append: show_arrows
    echo '}'
  endcapture

  capture config_mobile
    echo '{"perPage":' | append: mobile_columns
    echo ',"padding":{"left":"' | append: gutter | append: '","right":"calc(' | append: gutter | append: ' + var(--peek-next-slide-size, 0px))"}'
    echo '}'
  endcapture
-%}

{% capture blocks_content %}
  {% content_for 'blocks' %}
{% endcapture %}

{% capture slideshow_style %}
  --carousel-columns: {{ section.settings.columns }};
  --carousel-mobile-columns: {{ section.settings.mobile_columns }};
  {% render 'gap-style', value: section.settings.columns_gap, name: 'carousel-gap' %}
  {% render 'spacing-style', settings: block.settings %}
  {% render 'border-override', settings: block.settings %}
{% endcapture %}

{% assign slideshow_class = 'carousel-content spacing-style ' | append: color_scheme_class %}
<div class="force-full-width">
  {% render 'slider',
    class: slideshow_class,
    style: slideshow_style,
    slides_html: blocks_content,
    list_class: list_class,
    config: config,
    config_mobile: config_mobile,
    per_page: columns,
    per_page_mobile: mobile_columns,
    show_arrows: show_arrows,
    icon_style: icons_style,
    icon_shape: section.settings.icons_shape,
    arrows_class: arrows_class,
    attributes: block.shopify_attributes
  %}
</div>

{% stylesheet %}
  /* Cards are Splide slides (`_card` block root). Fill height is handled by the list's align-items. */
  .carousel-content .splide__list.items-stretch > .card {
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.carousel_content",
  "blocks": [
    {
      "type": "_card"
    }
  ],
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.card_height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "top",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        }
      ],
      "visible_if": "{{ block.settings.height == \"fit\" }}",
      "default": "top"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.carousel_content",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
