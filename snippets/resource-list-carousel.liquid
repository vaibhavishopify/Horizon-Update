{%- doc -%}
  Renders a carousel of resource cards (products, collections, articles) with Splide.
  Shared by the product list, collection list, featured blog posts, collection list page
  and product recommendations. Markup and initialisation come from snippets/slider.liquid
  and assets/slider.js; this snippet only translates section settings into slider options.

  Callers may still pass `slide_count`; Splide counts slides itself so it is ignored.

  @param {string} ref - The ref of the slider element
  @param {object} slides - An array of HTML for the slides to display in the carousel
  @param {object} settings - The block or section settings from the parent block/section.
  @param {string} [slide_width_max] - The maximum width of the slides on mobile.

  @example
  {% render 'resource-list-carousel', slides: slides, slide_count: slide_count, settings: block.settings %}
{%- enddoc -%}

{% liquid
  assign slider_ref = ref | default: 'resourceListCarousel'
  assign columns = settings.columns | default: 3
  assign columns_gap = settings.columns_gap | default: 16
  # Mobile gaps are capped at 12px, matching .resource-list in base.css
  assign mobile_gap = columns_gap | at_most: 12
  assign mobile_card_size = settings.mobile_card_size | default: '60cqw'
  assign slide_width_max = slide_width_max | default: '300px'

  assign show_arrows = false
  if settings.icons_style != 'none'
    assign show_arrows = true
  endif

  if settings.section_width == 'page-width'
    assign gutter = 'var(--util-page-margin-offset)'
    assign arrows_class = 'px-[var(--util-page-margin-offset)]'
  else
    assign gutter = '0px'
    assign arrows_class = ''
  endif

  # Desktop: `columns` slides per page, with the next slide peeking by --peek-next-slide-size.
  capture config
    echo '{"perPage":' | append: columns
    echo ',"gap":"' | append: columns_gap | append: 'px"'
    echo ',"padding":{"left":"' | append: gutter | append: '","right":"calc(' | append: gutter | append: ' + var(--peek-next-slide-size))"}'
    echo ',"arrows":' | append: show_arrows
    echo '}'
  endcapture

  # Mobile: cards use the merchant's mobile card size, clamped like the legacy carousel.
  capture config_mobile
    echo '{"perPage":1,"perMove":1'
    echo ',"fixedWidth":"clamp(150px, ' | append: mobile_card_size | append: ', ' | append: slide_width_max | append: ')"'
    echo ',"gap":"' | append: mobile_gap | append: 'px"'
    echo ',"padding":{"left":"' | append: gutter | append: '","right":"' | append: gutter | append: '"}'
    echo '}'
  endcapture
%}

{% render 'slider',
  slides: slides,
  ref: slider_ref,
  class: 'resource-list__slider @container w-full',
  track_class: 'py-4 -my-4',
  slide_class: 'resource-list__slide',
  config: config,
  config_mobile: config_mobile,
  per_page: columns,
  show_arrows: show_arrows,
  icon_style: settings.icons_style,
  icon_shape: settings.icons_shape,
  arrows_class: arrows_class
%}
