{%- doc -%}
  Renders pagination and autoplay controls for a Splide slider (`snippets/slider.liquid`).
  Pass the output as the slider's `controls` parameter so it sits inside the slider root,
  where Splide wires it up:
  - dots: a `.splide__pagination` list that Splide fills with one button per page
  - counter: "current / total", kept up to date by assets/slider.js (`[data-slider-current]`)
  - play/pause: a `.splide__toggle` button that Splide's Autoplay component controls

  @param {string} [style] - 'dots' | 'counter' | 'none' (default 'none')
  @param {number} [item_count] - Total slides, shown in the counter
  @param {boolean} [autoplay] - Render the play/pause toggle
  @param {boolean} [controls_on_media] - Float the controls over the bottom of the slides
  @param {string} [class] - Extra classes for the wrapper

  @example
  {% capture controls %}
    {% render 'slider-controls', style: 'dots', item_count: section.blocks.size, autoplay: true, controls_on_media: true %}
  {% endcapture %}
{%- enddoc -%}

{%- liquid
  assign style = style | default: 'none'
  if style == 'none' and autoplay != true
    break
  endif

  assign wrapper_class = 'slider-controls flex min-h-touch-target shrink-0 items-center justify-center gap-xs'
  if controls_on_media
    assign wrapper_class = wrapper_class | append: ' absolute inset-x-0 bottom-0 z-layer-raised text-white mix-blend-difference'
  endif
-%}

<div class="{{ wrapper_class }} {{ class }}">
  {% if autoplay %}
    <button
      type="button"
      class="splide__toggle slider-controls__toggle button button-unstyled flex size-touch-target items-center justify-center"
      aria-label="{{ 'accessibility.slideshow_pause' | t }}"
    >
      <span class="splide__toggle__pause flex">{{- 'icon-pause.svg' | inline_asset_content -}}</span>
      <span class="splide__toggle__play flex">{{- 'icon-play.svg' | inline_asset_content -}}</span>
    </button>
  {% endif %}

  {% case style %}
    {% when 'dots' %}
      <ul class="splide__pagination slider-controls__dots list-unstyled m-0 flex items-center justify-center gap-[0.6rem] rounded-[3rem] px-lg py-sm"></ul>
    {% when 'counter' %}
      <div class="slider-controls__counter flex items-center rounded-[2rem] px-sm py-[0.3rem] text-xs tabular-nums backdrop-blur-[10px]">
        <span data-slider-current>1</span><span class="slider-controls__slash px-2xs">/</span>{{ item_count }}
      </div>
  {% endcase %}
</div>

{% stylesheet %}
  /* Dot buttons are generated by Splide (`.splide__pagination__page`), so they are styled here rather than with utilities. */
  .slider-controls__dots .splide__pagination__page {
    --dot-size: 0.56rem;
    --dot-color: rgb(var(--color-foreground-rgb) / var(--opacity-30));

    display: block;
    width: var(--dot-size);
    height: var(--dot-size);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: var(--dot-color);
    box-shadow: inset 0 0 0 1.5px hsl(0 0% 0% / 0.15);
    cursor: pointer;
    transition: background-color var(--animation-speed) var(--animation-easing);

    &:hover {
      --dot-color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    }

    &.is-active {
      --dot-color: var(--color-foreground);

      box-shadow: inset 0 0 0 1.5px hsl(0 0% 0% / 0.4);
    }
  }

  /* Keep the 44px touch target around each small dot. */
  .slider-controls__dots li {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: calc(var(--minimum-touch-target) / 2);
    min-height: calc(var(--minimum-touch-target) / 2);
  }

  .slider-controls__counter {
    color: var(--color-foreground);
    background-color: rgb(0 0 0 / 40%);
  }

  .slider-controls__slash {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
  }

  /* Over media the controls read white, as the legacy controls did. */
  .slider-controls.mix-blend-difference {
    --color-foreground: #fff;
    --color-foreground-rgb: var(--color-white-rgb);
  }

  .slider-controls__toggle svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-xs);
    color: var(--color-foreground);
  }
{% endstylesheet %}
