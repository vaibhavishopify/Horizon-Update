{%- doc -%}
  Renders a carousel of predictive search results cards (collections, pages, articles) with Splide.
  Arrows sit in the header next to the title (desktop only) and only when there are four or more results.

  @param {string} title - The title of the carousel.
  @param {object} resources - The resources to display.
  @param {string} resource_type - The type of resource to display.
{%- enddoc -%}

{% liquid
  assign slides = ''
  for resource in resources
    capture card
      render 'resource-card', resource_type: resource_type, resource: resource, image_aspect_ratio: '4 / 5', collection_thumbnails: 'multiple'
    endcapture
    assign slides = slides | append: card
    unless forloop.last
      assign slides = slides | append: '<!--@slide/split-->'
    endunless
  endfor
  assign slides = slides | split: '<!--@slide/split-->'

  assign show_arrows = false
  if resources.size >= 4
    assign show_arrows = true
  endif

  # Cards are 27.5% of the list width with the theme's medium gap and extra-large gutters, as before.
  assign config = '{"fixedWidth":"27.5%","gap":"var(--gap-md)","padding":{"left":"var(--padding-xl)","right":"var(--padding-xl)"},"arrows":' | append: show_arrows | append: '}'
%}

{% capture header %}
  <div class="predictive-search-results__resource-header">
    <h4
      id="predictive-search-{{ resource_type }}"
      class="predictive-search-results__title"
    >
      {{ title }}
    </h4>

    {% if show_arrows %}
      {% render 'slider-arrows',
        icon_style: 'chevron',
        overlay: false,
        reveal: false,
        class: 'max-md:hidden'
      %}
    {% endif %}
  </div>
{% endcapture %}

{% render 'slider',
  slides: slides,
  slide_class: 'predictive-search-results__card',
  class: 'predictive-search-results__list list-unstyled pb-sm',
  track_class: 'py-xl -my-xl',
  header: header,
  config: config,
  per_page: 3
%}
